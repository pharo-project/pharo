"
I generate the smoke test classes of a project: one running its `<script>` methods, one checking its `<sampleInstance>` methods.

Each generated class is a subclass of `ParametrizedTestCase` in the test package of the project. It uses a trait of `SUnit-SmokeVerifier` and defines only, on its class side, the packages it checks and the methods it excludes.

## Responsibility:

- Know the project: its name, the packages to check and the package of its tests.
- Install the two classes, named after the project, for example `MyProjectScriptMethodsTest` and `MyProjectSampleInstanceMethodsTest`.
- Regenerate them without losing the excluded methods the project edited.

## Collaborators:

- `TSmokeScriptMethodsTest` and `TSmokeSampleInstanceMethodsTest`: the traits of the generated classes.
- `ParametrizedTestCase`: their superclass.

## Public API and Key Messages

- `projectName:`, `packageNames:` and `testPackageName:` configure me.
- `generate` installs both classes and answers them; `generateScriptTest` and `generateSampleInstanceTest` install one.
- `installTearDownInMorphic` generates both classes and makes them close the Morphic windows each method opens, by installing their own `runMethod`. Only for a project that depends on Morphic: `SUnit-SmokeVerifier` itself knows nothing about user interfaces.

```
ProjectSmokeVerifierGenerator new
	projectName: 'MyProject';
	packageNames: #( 'MyProject-Core' 'MyProject-UI' );
	testPackageName: 'MyProject-Tests';
	generate
```

## Internal Representation

- `projectName`: a string, the prefix of the generated class names.
- `packageNames`: the names of the packages to check.
- `testPackageName`: the package receiving the generated classes.
"
Class {
	#name : 'ProjectSmokeVerifierGenerator',
	#superclass : 'Object',
	#instVars : [
		'projectName',
		'packageNames',
		'testPackageName'
	],
	#category : 'SUnit-SmokeVerifier',
	#package : 'SUnit-SmokeVerifier'
}

{ #category : 'examples' }
ProjectSmokeVerifierGenerator class >> exampleMyProject [
	<sampleInstance>

	^ self new
		projectName: 'MyProject';
		packageNames: #( 'MyProject-Core' 'MyProject-UI' );
		testPackageName: 'MyProject-Tests';
		yourself
]

{ #category : 'generating' }
ProjectSmokeVerifierGenerator >> generate [
	"Install the two smoke test classes of my project and answer them."

	^ { self generateScriptTest. self generateSampleInstanceTest }
]

{ #category : 'generating' }
ProjectSmokeVerifierGenerator >> generateSampleInstanceTest [
	"Install and answer the class checking the <sampleInstance> methods of my packages."

	^ self generateTestNamed: self sampleInstanceTestName using: TSmokeSampleInstanceMethodsTest
]

{ #category : 'generating' }
ProjectSmokeVerifierGenerator >> generateScriptTest [
	"Install and answer the class running the <script> methods of my packages."

	^ self generateTestNamed: self scriptTestName using: TSmokeScriptMethodsTest
]

{ #category : 'generating' }
ProjectSmokeVerifierGenerator >> generateTestNamed: aSymbol using: aTrait [
	"Install and answer a subclass of ParametrizedTestCase named aSymbol, using aTrait and checking my packages. Generating it again updates its packages but keeps its excluded methods, which the project may have edited."

	| class |
	class := ParametrizedTestCase << aSymbol
		traits: aTrait;
		package: testPackageName;
		install.
	class class
		compile: ('packageNamesToCheck{1}{1}{2}^ {3}' format: { String cr. String tab. packageNames asArray printString })
		classified: #accessing.
	(class class includesLocalSelector: #excludedMethods) ifFalse: [
		class class
			compile: ('excludedMethods{1}{2}"Answer the methods not to run, as strings such as ''MyClass class>>#resetAll''."{1}{1}{2}^ #(  )' format: { String cr. String tab })
			classified: #accessing ].
	class comment: ('I run the smoke test of `{1}` on the packages of the project {2}. I was generated by `ProjectSmokeVerifierGenerator`; edit my class-side `excludedMethods` to leave out methods that must not be run by a test.' format: { aTrait name. projectName }).
	^ class
]

{ #category : 'generating - Morphic' }
ProjectSmokeVerifierGenerator >> installTearDownInMorphic [
	"Generate the two smoke test classes of my project, then make them close, after running each method, the Morphic windows it opened. Call me only for a project that depends on Morphic: the installed code uses Morphic. Answer the two classes."

	^ self generate
		do: [ :each | each compile: self morphicRunMethodSource classified: #running ];
		yourself
]

{ #category : 'generating - Morphic' }
ProjectSmokeVerifierGenerator >> morphicRunMethodSource [
	"Answer the source of the runMethod installed by installTearDownInMorphic: it runs the method like the trait, then deletes the morphs it added to the Morphic world."

	^ 'runMethod
	"Answer the result of running my method on its class, then close the Morphic windows it opened. Installed by ProjectSmokeVerifierGenerator>>#installTearDownInMorphic."

	| world before |
	world := self currentWorld.
	before := world submorphs copy.
	^ [ method valueWithReceiver: method methodClass instanceSide ] ensure: [
		world submorphs
			reject: [ :each | before includes: each ]
			thenDo: [ :each | each delete ] ]'
]

{ #category : 'accessing' }
ProjectSmokeVerifierGenerator >> packageNames [

	^ packageNames
]

{ #category : 'accessing' }
ProjectSmokeVerifierGenerator >> packageNames: someNames [

	packageNames := someNames
]

{ #category : 'accessing' }
ProjectSmokeVerifierGenerator >> projectName [

	^ projectName
]

{ #category : 'accessing' }
ProjectSmokeVerifierGenerator >> projectName: aString [

	projectName := aString
]

{ #category : 'accessing' }
ProjectSmokeVerifierGenerator >> sampleInstanceTestName [
	"Answer the name of the class checking the <sampleInstance> methods of my project."

	^ ('{1}SampleInstanceMethodsTest' format: { projectName }) asSymbol
]

{ #category : 'accessing' }
ProjectSmokeVerifierGenerator >> scriptTestName [
	"Answer the name of the class running the <script> methods of my project."

	^ ('{1}ScriptMethodsTest' format: { projectName }) asSymbol
]

{ #category : 'accessing' }
ProjectSmokeVerifierGenerator >> testPackageName [

	^ testPackageName
]

{ #category : 'accessing' }
ProjectSmokeVerifierGenerator >> testPackageName: aString [

	testPackageName := aString
]
